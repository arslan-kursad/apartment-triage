@page "/inbox"
@model ApartmentTriage.Web.Pages.Inbox.IndexModel
@using ApartmentTriage.Domain.Enums
@{
    ViewData["Title"]       = "Mesajlar";
    ViewData["PageTitleTR"] = "Mesajlar";
    ViewData["PageTitleEN"] = "Messages";
}

@* 3-panel inbox — full viewport height minus topbar *@
<div class="flex flex-col md:grid md:grid-cols-[28%_44%_28%] -m-4 md:-m-6 h-auto md:h-[calc(100vh-130px)] min-h-[500px] bg-white rounded-xl border border-gray-200 overflow-hidden">

    @* ── Left panel: message list (28%) ────────────────────────────────────────── *@
    @* Mobile master-detail: hide the list once a message is explicitly opened. *@
    <aside class="@(Model.TicketId.HasValue ? "hidden md:flex" : "flex") border-b border-gray-100 md:border-b-0 md:border-r flex-col overflow-hidden">
        <div class="px-3 py-3 border-b border-gray-100 space-y-2 shrink-0">
            <div class="flex items-center justify-between">
                <span class="text-xs font-semibold text-gray-500 uppercase tracking-wide">
                    <span class="lang-tr">Mesajlar</span>
                    <span class="lang-en">Messages</span>
                </span>
                <span class="text-xs text-gray-400">@Model.TotalMatching</span>
            </div>

            @* Search by resident name *@
            <form method="get" action="/inbox">
                <input type="hidden" name="Range" value="@Model.EffectiveRange" />
                <input type="hidden" name="PageSize" value="@Model.PageSize" />
                <input type="text" name="Q" value="@Model.Q"
                       placeholder="İsim ara…" data-i18n-tr-ph="İsim ara…" data-i18n-en-ph="Search name…"
                       class="w-full text-xs border border-gray-200 rounded-lg px-2.5 py-1.5 focus:outline-none focus:ring-2 focus:ring-blue-500" />
            </form>

            @* Quick date presets *@
            @{
                (string Val, string Tr, string En)[] presets =
                {
                    ("today", "Bugün", "Today"),
                    ("week",  "Bu Hafta", "This Week"),
                    ("all",   "Tümü", "All")
                };
            }
            <div class="flex items-center gap-1">
                @foreach (var p in presets)
                {
                    var active = Model.EffectiveRange == p.Val;
                    var cls = active
                        ? "px-2 py-0.5 rounded-full text-xs font-medium bg-blue-600 text-white"
                        : "px-2 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200";
                    <a href="@Model.PresetUrl(p.Val)" class="@cls">
                        <span class="lang-tr">@p.Tr</span>
                        <span class="lang-en">@p.En</span>
                    </a>
                }
            </div>
        </div>
        <ul class="flex-1 overflow-y-auto">
            @foreach (var item in Model.Items)
            {
                var isSelected = Model.Detail?.TicketId == item.TicketId;
                var rowClass = isSelected
                    ? "px-3 py-2.5 bg-blue-50 border-l-2 border-blue-500 cursor-pointer"
                    : "px-3 py-2.5 hover:bg-gray-50 border-l-2 border-transparent cursor-pointer transition-colors";

                <li class="@rowClass"
                    onclick="window.location='@Model.SelectUrl(item.TicketId)'">
                    <div class="flex items-center gap-1.5 mb-0.5">
                        @* Avatar: initials or channel icon fallback *@
                        @if (item.Initials == "?")
                        {
                            <span class="w-6 h-6 rounded-full bg-gray-100 flex items-center justify-center shrink-0">
                                @if (item.Channel == ChannelType.WhatsApp)
                                {
                                    <i class="fa-brands fa-whatsapp" style="color:#25D366;font-size:12px"></i>
                                }
                                else if (item.Channel == ChannelType.Telegram)
                                {
                                    <i class="fa-brands fa-telegram" style="color:#229ED9;font-size:12px"></i>
                                }
                                else
                                {
                                    <span class="text-xs text-gray-400">?</span>
                                }
                            </span>
                        }
                        else
                        {
                            <span class="w-6 h-6 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center text-xs font-bold shrink-0">@item.Initials</span>
                        }
                        <span class="text-xs font-medium text-gray-800 truncate">@if (string.IsNullOrEmpty(item.Resident)) { <span data-i18n-tr="Sakin" data-i18n-en="Resident">Sakin</span> } else { @item.Resident }</span>
                    </div>
                    <p class="text-xs text-gray-400 truncate">@item.Preview</p>
                    <div class="flex items-center justify-between mt-1">
                        <span class="inline-flex items-center">
                            @if (item.Channel == ChannelType.WhatsApp)
                            {
                                <i class="fa-brands fa-whatsapp" style="color:#25D366;font-size:13px"></i>
                            }
                            else if (item.Channel == ChannelType.Telegram)
                            {
                                <i class="fa-brands fa-telegram" style="color:#229ED9;font-size:13px"></i>
                            }
                            else
                            {
                                <span class="w-2 h-2 rounded-full bg-gray-300 inline-block"></span>
                            }
                        </span>
                        @if (item.IsEmergency)
                        {
                            <span class="text-xs font-bold text-red-600">!</span>
                        }
                        <span class="text-xs text-gray-300">@item.TimeIst</span>
                    </div>
                </li>
            }
            @if (!Model.Items.Any())
            {
                <li class="px-3 py-6 text-center">
                    <p class="text-xs text-gray-400">
                        <span class="lang-tr">Mesaj yok</span>
                        <span class="lang-en">No messages</span>
                    </p>
                </li>
            }
        </ul>

        @* Left-list pagination (page size + prev/next) *@
        @if (Model.TotalMatching > 0)
        {
            <div class="border-t border-gray-100 px-2 py-2 flex items-center justify-between gap-2 text-xs text-gray-500 shrink-0">
                <select onchange="location.href=this.value"
                        class="border border-gray-200 rounded-md px-1.5 py-0.5 bg-white text-xs focus:outline-none focus:ring-2 focus:ring-blue-500">
                    @foreach (var size in Model.PageSizeOptions)
                    {
                        <option value="@Model.PageSizeUrl(size)" selected="@(Model.PageSize == size)">@size</option>
                    }
                </select>
                <div class="flex items-center gap-1">
                    @if (Model.CurrentPage > 1)
                    {
                        <a href="@Model.PageUrl(Model.CurrentPage - 1)" class="px-1.5 py-0.5 rounded-md border border-gray-200 text-gray-600 hover:bg-gray-50" aria-label="Previous">‹</a>
                    }
                    else
                    {
                        <span class="px-1.5 py-0.5 rounded-md border border-gray-100 text-gray-300">‹</span>
                    }
                    <span class="tabular-nums">@Model.CurrentPage/@Model.TotalPages</span>
                    @if (Model.CurrentPage < Model.TotalPages)
                    {
                        <a href="@Model.PageUrl(Model.CurrentPage + 1)" class="px-1.5 py-0.5 rounded-md border border-gray-200 text-gray-600 hover:bg-gray-50" aria-label="Next">›</a>
                    }
                    else
                    {
                        <span class="px-1.5 py-0.5 rounded-md border border-gray-100 text-gray-300">›</span>
                    }
                </div>
            </div>
        }
    </aside>

    @if (Model.Detail is not null)
    {
        var d = Model.Detail;
        var sevColor = d.Severity switch
        {
            TicketSeverity.Urgent => "bg-red-100 text-red-700",
            TicketSeverity.High   => "bg-orange-100 text-orange-700",
            TicketSeverity.Medium => "bg-blue-100 text-blue-700",
            _                     => "bg-gray-100 text-gray-600"
        };
        var confPct = d.Confidence switch { ConfidenceLevel.High => 100, ConfidenceLevel.Medium => 60, _ => 33 };
        var confColor = d.Confidence switch
        {
            ConfidenceLevel.High   => "bg-green-500",
            ConfidenceLevel.Medium => "bg-yellow-400",
            _                      => "bg-red-400"
        };

        @* ── Middle panel: chat window (44%) ───────────────────────────────────── *@
        @* Mobile: shown only when a message is explicitly opened (master-detail). *@
        <div class="@(Model.TicketId.HasValue ? "flex" : "hidden md:flex") flex-col min-w-0 border-b border-gray-100 md:border-b-0 md:border-r min-h-[300px] md:min-h-0">
            @* Mobile back-to-list bar *@
            <a href="@Model.BackToListUrl"
               class="md:hidden flex items-center gap-1.5 px-4 py-2.5 border-b border-gray-100 text-xs font-medium text-blue-600 shrink-0">
                <span aria-hidden="true">←</span>
                <span class="lang-tr">Mesajlara dön</span>
                <span class="lang-en">Back to messages</span>
            </a>
            @* Chat header *@
            <div class="px-4 py-3 border-b border-gray-100 flex items-center gap-2 shrink-0">
                <span class="w-8 h-8 rounded-full bg-gray-200 text-gray-600 flex items-center justify-center text-sm font-bold">@d.Initials</span>
                <div>
                    <p class="text-sm font-semibold text-gray-900">@if (string.IsNullOrEmpty(d.Resident)) { <span data-i18n-tr="Sakin" data-i18n-en="Resident">Sakin</span> } else { @d.Resident }</p>
                    <div class="flex items-center gap-1.5 text-xs text-gray-400">
                        @if (d.Channel == ChannelType.WhatsApp)
                        {
                            <i class="fa-brands fa-whatsapp" style="color:#25D366;font-size:14px"></i>
                        }
                        else if (d.Channel == ChannelType.Telegram)
                        {
                            <i class="fa-brands fa-telegram" style="color:#229ED9;font-size:14px"></i>
                        }
                        else
                        {
                            <span class="w-2 h-2 rounded-full bg-gray-400"></span>
                        }
                        @d.Channel
                        @if (d.IsEmergency)
                        {
                            <span class="px-1.5 py-0.5 rounded text-xs font-bold bg-red-600 text-white">
                                <span class="lang-tr">ACİL</span>
                                <span class="lang-en">EMRG</span>
                            </span>
                        }
                    </div>
                </div>
            </div>

            @* Chat bubbles *@
            <div class="flex-1 overflow-y-auto p-4 space-y-3">
                @* Incoming message *@
                <div class="flex justify-start">
                    <div class="max-w-xs lg:max-w-md">
                        <div class="bg-gray-100 rounded-2xl rounded-tl-sm px-4 py-2.5">
                            <p class="text-sm text-gray-800 whitespace-pre-wrap break-words">@d.RawText</p>
                        </div>
                        <p class="text-xs text-gray-400 mt-1 ml-1">@d.ReceivedAt IST</p>
                    </div>
                </div>

                @* Draft reply preview (outgoing bubble, dimmed) *@
                <div class="flex justify-end" id="reply-preview-bubble" style="display:none !important">
                    <div class="max-w-xs lg:max-w-md">
                        <div class="bg-blue-500 rounded-2xl rounded-tr-sm px-4 py-2.5">
                            <p class="text-sm text-white whitespace-pre-wrap break-words" id="reply-preview-text"></p>
                        </div>
                        <p class="text-xs text-gray-400 mt-1 text-right mr-1">
                            <span class="lang-tr">Gönderildi</span>
                            <span class="lang-en">Sent</span>
                            ✓
                        </p>
                    </div>
                </div>

                @* Success/error status *@
                <div id="reply-status" class="text-xs text-center" style="display:none"></div>
            </div>
        </div>

        @* ── Right panel: AI triage + reply (28%) ─────────────────────────────── *@
        @* Mobile: shown only when a message is explicitly opened (master-detail). *@
        <aside class="@(Model.TicketId.HasValue ? "flex" : "hidden md:flex") flex-col overflow-hidden">
            @* Resident info *@
            <div class="px-3 py-3 border-b border-gray-100">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">
                    <span class="lang-tr">Sakin</span>
                    <span class="lang-en">Resident</span>
                </p>
                <div class="space-y-1">
                    <p class="text-xs font-medium text-gray-800">
                        @if (d.ResidentDisplayName is { Length: > 0 } dn)
                        {
                            @dn
                        }
                        else
                        {
                            <span class="lang-tr">Bilinmiyor</span>
                            <span class="lang-en">Unknown</span>
                        }
                    </p>
                    <p class="text-xs text-gray-500 flex items-center gap-1.5">
                        <span>
                            <span class="lang-tr">Kanal:</span>
                            <span class="lang-en">Channel:</span>
                        </span>
                        @if (d.Channel == ChannelType.WhatsApp)
                        {
                            <i class="fa-brands fa-whatsapp" style="color:#25D366;font-size:13px"></i>
                            <span>WhatsApp</span>
                        }
                        else if (d.Channel == ChannelType.Telegram)
                        {
                            <i class="fa-brands fa-telegram" style="color:#229ED9;font-size:13px"></i>
                            <span>Telegram</span>
                        }
                        else
                        {
                            <span class="text-gray-400">—</span>
                        }
                    </p>
                    <p class="text-xs text-gray-500">
                        <span class="lang-tr">Daire:</span>
                        <span class="lang-en">Unit:</span>
                        @(d.ResidentApartmentNumber ?? "—")
                    </p>
                    @if (d.ResidentId.HasValue)
                    {
                        <a href="/residents?edit=@d.ResidentId"
                           class="text-xs text-blue-600 hover:text-blue-700 hover:underline">
                            <span class="lang-tr">Sakini Düzenle →</span>
                            <span class="lang-en">Edit Resident →</span>
                        </a>
                    }
                </div>
            </div>

            @* Triage metadata *@
            <div class="px-3 py-3 border-b border-gray-100">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">
                    <span class="lang-tr">AI Triage</span>
                    <span class="lang-en">AI Triage</span>
                </p>

                <div class="space-y-2">
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-gray-500">
                            <span class="lang-tr">Kategori</span>
                            <span class="lang-en">Category</span>
                        </span>
                        <span class="px-1.5 py-0.5 rounded-full text-xs font-medium bg-blue-100 text-blue-700">@d.Category</span>
                    </div>
                    <div class="flex items-center justify-between">
                        <span class="text-xs text-gray-500">
                            <span class="lang-tr">Şiddet</span>
                            <span class="lang-en">Severity</span>
                        </span>
                        <span class="px-1.5 py-0.5 rounded-full text-xs font-medium @sevColor">@d.Severity</span>
                    </div>
                    @if (d.LocationHint is not null)
                    {
                        <div class="flex items-center justify-between gap-2">
                            <span class="text-xs text-gray-500 shrink-0">
                                <span class="lang-tr">Konum</span>
                                <span class="lang-en">Location</span>
                            </span>
                            <span class="text-xs text-gray-700 text-right truncate">@d.LocationHint</span>
                        </div>
                    }
                    @if (d.RoutingAction.HasValue)
                    {
                        <div class="flex items-center justify-between">
                            <span class="text-xs text-gray-500">
                                <span class="lang-tr">Aksiyon</span>
                                <span class="lang-en">Action</span>
                            </span>
                            <span class="text-xs text-gray-700">@d.RoutingAction.Value</span>
                        </div>
                    }
                    @* Confidence bar *@
                    <div>
                        <div class="flex justify-between text-xs text-gray-400 mb-1">
                            <span>
                                <span class="lang-tr">Güven</span>
                                <span class="lang-en">Confidence</span>
                            </span>
                            <span>@d.Confidence</span>
                        </div>
                        <div class="w-full bg-gray-100 rounded-full h-1.5">
                            <div class="@confColor h-1.5 rounded-full" style="width: @(confPct)%"></div>
                        </div>
                    </div>
                </div>
            </div>

            @* Draft reply section *@
            @{
                var isOpen = d.Status == TicketStatus.Open;
                var sendableRouting = d.RoutingAction is
                    RoutingAction.EscalateToManager or
                    RoutingAction.AssignTechnician or
                    RoutingAction.NotifyResident;
                var showSend = isOpen && sendableRouting && !string.IsNullOrEmpty(d.DraftReply);
                var sendDisabledWa = showSend && d.Channel == ChannelType.WhatsApp;
            }
            <div class="flex-1 flex flex-col p-3 overflow-hidden">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">
                    <span class="lang-tr">Taslak Yanıt</span>
                    <span class="lang-en">Draft Reply</span>
                </p>
                <textarea id="reply-textarea"
                          class="flex-1 w-full text-xs text-gray-700 border border-gray-200 rounded-lg p-2 resize-none focus:outline-none focus:ring-2 focus:ring-blue-500"
                          placeholder="Yanıtı buraya yazın…"
                          data-i18n-tr-ph="Yanıtı buraya yazın…"
                          data-i18n-en-ph="Type your reply here…"
                >@d.DraftReply</textarea>

                @if (showSend)
                {
                    if (sendDisabledWa)
                    {
                        <button id="send-btn"
                                disabled
                                title="WhatsApp yanıtları otomatik gönderilir"
                                class="mt-2 w-full py-2 bg-gray-300 text-gray-500 text-xs font-semibold rounded-lg cursor-not-allowed opacity-60">
                            <span class="lang-tr">Gönder (WhatsApp)</span>
                            <span class="lang-en">Send (WhatsApp)</span>
                        </button>
                    }
                    else
                    {
                        <button id="send-btn"
                                onclick="sendReply('@d.TicketId')"
                                class="mt-2 w-full py-2 bg-blue-600 hover:bg-blue-700 text-white text-xs font-semibold rounded-lg transition-colors disabled:opacity-50">
                            <span class="lang-tr">Onayla & Gönder ✓</span>
                            <span class="lang-en">Approve & Send ✓</span>
                        </button>
                    }
                }
            </div>
        </aside>
    }
    else
    {
        @* No ticket selected *@
        <div class="flex-1 flex items-center justify-center">
            <p class="text-sm text-gray-400">
                <span class="lang-tr">Soldan bir mesaj seçin</span>
                <span class="lang-en">Select a message on the left</span>
            </p>
        </div>
    }

</div>

@section Scripts {
<script>
    function sendReply(ticketId) {
        var ta = document.getElementById('reply-textarea');
        var btn = document.getElementById('send-btn');
        var status = document.getElementById('reply-status');
        if (!ta || !btn || !ticketId) return;

        var text = ta.value.trim();
        if (!text) {
            var lang = localStorage.getItem('atriage_lang') || 'tr';
            alert(lang === 'tr' ? 'Yanıt boş olamaz.' : 'Reply cannot be empty.');
            return;
        }

        btn.disabled = true;
        if (status) { status.style.display = 'none'; }

        fetch('/api/messages/' + ticketId + '/reply', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ text: text })
        })
        .then(function(r) { return r.json(); })
        .then(function(data) {
            if (data.success) {
                // Show sent bubble
                var preview = document.getElementById('reply-preview-bubble');
                var previewText = document.getElementById('reply-preview-text');
                if (preview && previewText) {
                    previewText.textContent = text;
                    preview.style.removeProperty('display');
                }
                if (status) {
                    var lang = localStorage.getItem('atriage_lang') || 'tr';
                    status.style.display = 'block';
                    status.className = 'text-xs text-center text-green-600';
                    status.textContent = lang === 'tr' ? '✓ Gönderildi' : '✓ Sent';
                }
                btn.textContent = '✓';
                btn.disabled = true;
            } else {
                btn.disabled = false;
                if (status) {
                    status.style.display = 'block';
                    status.className = 'text-xs text-center text-red-500';
                    status.textContent = data.error || 'Error';
                }
            }
        })
        .catch(function(e) {
            btn.disabled = false;
            if (status) {
                status.style.display = 'block';
                status.className = 'text-xs text-center text-red-500';
                var lang = localStorage.getItem('atriage_lang') || 'tr';
                status.textContent = lang === 'tr' ? 'Gönderilemedi.' : 'Failed to send.';
            }
        });
    }
</script>
}
