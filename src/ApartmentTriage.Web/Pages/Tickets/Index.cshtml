@page
@model ApartmentTriage.Web.Pages.Tickets.IndexModel
@using ApartmentTriage.Domain.Enums
@using ApartmentTriage.Web.Helpers
@{
    ViewData["Title"]       = "Ticket'lar";
    ViewData["PageTitleTR"] = "Ticket'lar";
    ViewData["PageTitleEN"] = "Tickets";
}

@* ── Header + filter ──────────────────────────────────────────────────────────── *@
<div class="flex items-center justify-between mb-4">
    <div>
        <p class="text-sm text-gray-500">
            <span class="lang-tr">Toplam:</span>
            <span class="lang-en">Total:</span>
            <span class="font-semibold text-gray-900">@Model.TotalCount</span>
        </p>
    </div>
</div>

<form method="get" class="flex flex-wrap gap-2 mb-4">
    @* Preserve the date range when other filters change *@
    <input type="hidden" name="Range" value="@Model.EffectiveRange" />
    <select name="FilterStatus" class="text-sm border border-gray-200 rounded-lg px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="" data-i18n-tr="Tüm Statüler" data-i18n-en="All Statuses">Tüm Statüler</option>
        @foreach (var s in Model.AllStatuses)
        {
            var lbl = EnumLabels.For(s);
            <option value="@s" selected="@(Model.FilterStatus == s)" data-i18n-tr="@lbl.Tr" data-i18n-en="@lbl.En">@lbl.Tr</option>
        }
    </select>

    <select name="FilterCategory" class="text-sm border border-gray-200 rounded-lg px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value="" data-i18n-tr="Tüm Kategoriler" data-i18n-en="All Categories">Tüm Kategoriler</option>
        @foreach (var c in Model.AllCategories)
        {
            var lbl = EnumLabels.For(c);
            <option value="@c" selected="@(Model.FilterCategory == c)" data-i18n-tr="@lbl.Tr" data-i18n-en="@lbl.En">@lbl.Tr</option>
        }
    </select>

    <select name="FilterIsEmergency" class="text-sm border border-gray-200 rounded-lg px-3 py-1.5 bg-white focus:outline-none focus:ring-2 focus:ring-blue-500">
        <option value=""      data-i18n-tr="Acil Durum: Tümü" data-i18n-en="Emergency: All">Acil Durum: Tümü</option>
        <option value="true"  selected="@(Model.FilterIsEmergency == true)"  data-i18n-tr="Acil"   data-i18n-en="Emergency">Acil</option>
        <option value="false" selected="@(Model.FilterIsEmergency == false)" data-i18n-tr="Normal" data-i18n-en="Normal">Normal</option>
    </select>

    <button type="submit" class="text-sm px-3 py-1.5 bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors">
        <span class="lang-tr">Filtrele</span>
        <span class="lang-en">Filter</span>
    </button>
    <a href="/tickets" class="text-sm px-3 py-1.5 border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50 transition-colors">
        <span class="lang-tr">Temizle</span>
        <span class="lang-en">Clear</span>
    </a>
</form>

@* ── Date presets ─────────────────────────────────────────────────────────────── *@
@{
    (string Val, string Tr, string En)[] datePresets =
    {
        ("today", "Bugün", "Today"),
        ("week",  "Bu Hafta", "This Week"),
        ("all",   "Tümü", "All")
    };
}
<div class="flex items-center gap-1.5 mb-4 -mt-1">
    <span class="text-xs text-gray-400 mr-1">
        <span class="lang-tr">Tarih:</span>
        <span class="lang-en">Date:</span>
    </span>
    @foreach (var p in datePresets)
    {
        var active = Model.EffectiveRange == p.Val;
        var cls = active
            ? "px-2.5 py-1 rounded-full text-xs font-medium bg-blue-600 text-white"
            : "px-2.5 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-600 hover:bg-gray-200";
        <a href="@Model.PresetUrl(p.Val)" class="@cls">
            <span class="lang-tr">@p.Tr</span>
            <span class="lang-en">@p.En</span>
        </a>
    }
</div>

@* ── Active deep-link filter chip (overview / residents cross-link) ───────────── *@
@if (Model.Emergency == true || Model.Resident.HasValue)
{
    <div class="mb-4">
        <span class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium bg-blue-50 text-blue-700 border border-blue-200">
            @if (Model.Emergency == true)
            {
                <span>
                    <span class="lang-tr">Acil durumlar gösteriliyor</span>
                    <span class="lang-en">Showing emergencies</span>
                </span>
            }
            else
            {
                <span>
                    <span class="lang-tr">Sakin ticket'ları: @(Model.ResidentLabel ?? "—")</span>
                    <span class="lang-en">Resident tickets: @(Model.ResidentLabel ?? "—")</span>
                </span>
            }
            <a href="/tickets" class="inline-flex items-center gap-1 text-blue-500 hover:text-blue-800">
                <span class="lang-tr">filtreyi temizle</span>
                <span class="lang-en">clear filter</span>
                <i class="fa-solid fa-xmark"></i>
            </a>
        </span>
    </div>
}

@* ── Status count cards (compact strip, click to filter) ─────────────────────── *@
<div id="status-cards" class="flex flex-wrap gap-2 mb-4"></div>

@* ── Ticket list ───────────────────────────────────────────────────────────────── *@
@if (!Model.Tickets.Any())
{
    <div class="bg-white rounded-xl border border-gray-200 p-8 text-center">
        <p class="text-gray-400 text-sm">
            <span class="lang-tr">Filtreyle eşleşen ticket bulunamadı.</span>
            <span class="lang-en">No tickets match the filter.</span>
        </p>
    </div>
}
else
{
    <div class="bg-white rounded-xl border border-gray-200 overflow-hidden">
        <ul class="divide-y divide-gray-100">
            @foreach (var t in Model.Tickets)
            {
                var channelType = t.SourceMessage?.ChannelType ?? ChannelType.Mock;
                var sevColor = t.Severity switch
                {
                    TicketSeverity.Urgent => "bg-red-100 text-red-700",
                    TicketSeverity.High   => "bg-orange-100 text-orange-700",
                    TicketSeverity.Medium => "bg-blue-100 text-blue-700",
                    _                     => "bg-gray-100 text-gray-600"
                };
                var statusColor = t.Status switch
                {
                    TicketStatus.Open       => "bg-blue-50 text-blue-700 border-blue-200",
                    TicketStatus.InProgress => "bg-amber-50 text-amber-700 border-amber-200",
                    TicketStatus.Resolved   => "bg-green-50 text-green-700 border-green-200",
                    TicketStatus.Closed     => "bg-gray-50 text-gray-600 border-gray-200",
                    _                       => "bg-gray-50 text-gray-600 border-gray-200"
                };
                var catLbl = EnumLabels.For(t.Category);
                var stLbl  = EnumLabels.For(t.Status);
                var svLbl  = EnumLabels.For(t.Severity);
                var preview = t.SourceMessage?.RawText is { Length: > 0 } raw
                    ? (raw.Length > 60 ? raw[..60] + "…" : raw)
                    : "—";
                var sender = t.Resident?.ApartmentNumber is { Length: > 0 } apt ? apt : "—";

                <li class="px-5 py-4 hover:bg-gray-50 transition-colors">
                    <div class="flex items-start justify-between gap-4">
                        <div class="flex items-start gap-3 min-w-0">
                            @* Channel icon *@
                            <span class="mt-0.5 shrink-0 w-5 text-center">
                                @if (channelType == ChannelType.WhatsApp)
                                {
                                    <i class="fa-brands fa-whatsapp" style="color:#25D366;font-size:15px"></i>
                                }
                                else if (channelType == ChannelType.Telegram)
                                {
                                    <i class="fa-brands fa-telegram" style="color:#229ED9;font-size:15px"></i>
                                }
                                else
                                {
                                    <span class="inline-block w-2.5 h-2.5 rounded-full bg-gray-400 mt-1"></span>
                                }
                            </span>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="font-medium text-sm text-gray-900" data-i18n-tr="@catLbl.Tr" data-i18n-en="@catLbl.En">@catLbl.Tr</span>
                                    @if (t.IsEmergency)
                                    {
                                        <span class="px-1.5 py-0.5 rounded text-xs font-bold bg-red-600 text-white">
                                            <span class="lang-tr">ACİL</span>
                                            <span class="lang-en">EMRG</span>
                                        </span>
                                    }
                                    <span class="px-2 py-0.5 rounded-full text-xs font-medium border @statusColor" data-i18n-tr="@stLbl.Tr" data-i18n-en="@stLbl.En">@stLbl.Tr</span>
                                </div>
                                <p class="text-xs text-gray-400 mt-0.5 truncate">@preview</p>
                                <p class="text-xs text-gray-400 mt-0.5">@sender</p>
                            </div>
                        </div>
                        <div class="shrink-0 flex flex-col items-end gap-1.5">
                            <span class="px-2 py-0.5 rounded-full text-xs font-medium @sevColor" data-i18n-tr="@svLbl.Tr" data-i18n-en="@svLbl.En">@svLbl.Tr</span>
                            <span class="text-xs text-gray-400">@IstanbulTime.Format(t.CreatedAt)</span>
                            <a href="/tickets/@t.Id"
                               class="text-xs text-blue-600 hover:underline font-medium">
                                <span class="lang-tr">Detay →</span>
                                <span class="lang-en">Detail →</span>
                            </a>
                        </div>
                    </div>
                </li>
            }
        </ul>
    </div>

    @* Pagination *@
    @if (Model.TotalPages > 1)
    {
        <div class="flex items-center justify-center gap-2 mt-4">
            @if (Model.CurrentPage > 1)
            {
                <a href="@Model.BuildUrl(Model.CurrentPage - 1)"
                   class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50">
                    <span class="lang-tr">← Önceki</span>
                    <span class="lang-en">← Previous</span>
                </a>
            }
            <span class="px-3 py-1.5 text-sm text-gray-500">@Model.CurrentPage / @Model.TotalPages</span>
            @if (Model.CurrentPage < Model.TotalPages)
            {
                <a href="@Model.BuildUrl(Model.CurrentPage + 1)"
                   class="px-3 py-1.5 text-sm border border-gray-200 rounded-lg text-gray-600 hover:bg-gray-50">
                    <span class="lang-tr">Sonraki →</span>
                    <span class="lang-en">Next →</span>
                </a>
            }
        </div>
    }
}

@section Scripts {
<script>
(function () {
    // Shared status palette — kept in sync with the Overview status panel.
    var STATUS = {
        Open:       { tr: 'Açık',    en: 'Open',        cls: 'border-blue-200 bg-blue-50 text-blue-700',    dot: '#3B82F6' },
        InProgress: { tr: 'İşlemde', en: 'In Progress', cls: 'border-amber-200 bg-amber-50 text-amber-700', dot: '#F59E0B' },
        Resolved:   { tr: 'Çözüldü', en: 'Resolved',    cls: 'border-green-200 bg-green-50 text-green-700', dot: '#22C55E' },
        Closed:     { tr: 'Kapalı',  en: 'Closed',      cls: 'border-gray-200 bg-gray-50 text-gray-600',    dot: '#6B7280' }
    };
    var el = document.getElementById('status-cards');
    if (!el) return;
    fetch('/api/stats/ticket-status')
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (!data || !data.length) return;
            var lang = window.atriageLang ? window.atriageLang() : 'tr';
            el.innerHTML = data.map(function (d) {
                var s = STATUS[d.status] || { tr: d.status, en: d.status, cls: 'border-gray-200 bg-gray-50 text-gray-600', dot: '#6B7280' };
                var label = lang === 'en' ? s.en : s.tr;
                // Click filters to this status (count matches; no date carry-over).
                var href = '/tickets?FilterStatus=' + encodeURIComponent(d.status);
                return '<a href="' + href + '" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border ' + s.cls + ' hover:shadow-sm transition-all">' +
                       '<span class="w-2 h-2 rounded-full" style="background:' + s.dot + '"></span>' +
                       '<span class="text-xs font-medium" data-i18n-tr="' + s.tr + '" data-i18n-en="' + s.en + '">' + label + '</span>' +
                       '<span class="text-sm font-bold">' + d.count + '</span>' +
                       '</a>';
            }).join('');
            if (window.applyLang) window.applyLang(lang);
        })
        .catch(function (e) { console.warn('status-cards fetch failed', e); });
})();
</script>
}
