@page "/tickets/{id:guid}"
@model ApartmentTriage.Web.Pages.Tickets.DetailModel
@{
    ViewData["Title"] = $"Ticket {Model.Ticket!.Id.ToString()[..8]}";
    var t = Model.Ticket!;
}

<div class="mb-3">
    <a href="/tickets" class="btn btn-sm btn-outline-secondary">&larr; Listeye Dön</a>
</div>

<h1 class="h4 mb-4">
    Ticket Detayı
    @if (t.IsEmergency)
    {
        <span class="badge bg-danger ms-2">ACİL</span>
    }
</h1>

<div class="row g-4">

    @* ── Kaynak Mesaj ────────────────────────────────────────────────────────── *@
    <div class="col-12">
        <div class="card">
            <div class="card-header fw-semibold">Kaynak Mesaj</div>
            <div class="card-body">
                @if (t.SourceMessage is not null)
                {
                    <p class="mb-1">
                        <span class="text-muted">Kanal:</span>
                        <strong>@t.SourceMessage.ChannelType</strong>
                        &nbsp;|&nbsp;
                        <span class="text-muted">Alındı:</span>
                        <strong>@t.SourceMessage.ReceivedAt.ToString("dd MMM yyyy HH:mm:ss") UTC</strong>
                    </p>
                    <blockquote class="blockquote mt-2 mb-0 p-3 bg-light rounded font-monospace" style="font-size:.9rem">
                        @t.SourceMessage.RawText
                    </blockquote>
                    @if (t.SourceMessage.ImageData != null)
                    {
                        var base64 = Convert.ToBase64String(t.SourceMessage.ImageData);
                        var mime   = t.SourceMessage.ImageMimeType ?? "image/jpeg";
                        <div class="mt-3">
                            <p class="text-muted small mb-1">Ekteki Görsel</p>
                            <img src="data:@mime;base64,@base64"
                                 class="img-fluid rounded"
                                 style="max-width:480px" />
                        </div>
                    }
                }
                else
                {
                    <span class="text-muted">Mesaj verisi yüklenemedi.</span>
                }
            </div>
        </div>
    </div>

    @* ── Temel Alanlar ───────────────────────────────────────────────────────── *@
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Ticket Bilgileri</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">ID</dt>
                    <dd class="col-sm-7 font-monospace small">@t.Id</dd>

                    <dt class="col-sm-5">Resident ID</dt>
                    <dd class="col-sm-7 font-monospace small">@t.ResidentId</dd>

                    <dt class="col-sm-5">Statü</dt>
                    <dd class="col-sm-7"><span class="badge bg-secondary">@t.Status</span></dd>

                    <dt class="col-sm-5">Oluşturulma</dt>
                    <dd class="col-sm-7">@t.CreatedAt.ToString("dd MMM yyyy HH:mm:ss") UTC</dd>

                    <dt class="col-sm-5">Güncellenme</dt>
                    <dd class="col-sm-7">@t.UpdatedAt.ToString("dd MMM yyyy HH:mm:ss") UTC</dd>

                    @if (t.LocationHint is not null)
                    {
                        <dt class="col-sm-5">Konum</dt>
                        <dd class="col-sm-7">@t.LocationHint</dd>
                    }

                    @if (t.Context is not null)
                    {
                        <dt class="col-sm-5">Bağlam</dt>
                        <dd class="col-sm-7 small">@t.Context</dd>
                    }

                    @if (t.Notes is not null)
                    {
                        <dt class="col-sm-5">Notlar</dt>
                        <dd class="col-sm-7 small">@t.Notes</dd>
                    }
                </dl>
            </div>
        </div>
    </div>

    @* ── Agent Kararları ─────────────────────────────────────────────────────── *@
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header fw-semibold">Agent Kararları (DB)</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Kategori</dt>
                    <dd class="col-sm-7">
                        <span class="badge bg-primary">@t.Category</span>
                    </dd>

                    <dt class="col-sm-5">Şiddet</dt>
                    <dd class="col-sm-7">
                        @{
                            var sevClass = t.Severity switch
                            {
                                ApartmentTriage.Domain.Enums.TicketSeverity.Urgent => "badge bg-danger",
                                ApartmentTriage.Domain.Enums.TicketSeverity.High   => "badge bg-warning text-dark",
                                ApartmentTriage.Domain.Enums.TicketSeverity.Medium => "badge bg-info text-dark",
                                _                                                   => "badge bg-secondary"
                            };
                        }
                        <span class="@sevClass">@t.Severity</span>
                    </dd>

                    <dt class="col-sm-5">Kategori Güven</dt>
                    <dd class="col-sm-7">@t.CategoryConfidence</dd>

                    <dt class="col-sm-5">Acil Durum</dt>
                    <dd class="col-sm-7">
                        @if (t.IsEmergency)
                        {
                            <span class="badge bg-danger">EVET</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Hayır</span>
                        }
                    </dd>

                    <dt class="col-sm-5">Acil Güven</dt>
                    <dd class="col-sm-7">@t.EmergencyConfidence</dd>

                    <dt class="col-sm-5">Yönlendirme</dt>
                    <dd class="col-sm-7">
                        @if (t.RoutingAction.HasValue)
                        {
                            var routeClass = t.RoutingAction.Value switch
                            {
                                ApartmentTriage.Domain.Enums.RoutingAction.TriggerEmergency   => "badge bg-danger",
                                ApartmentTriage.Domain.Enums.RoutingAction.EscalateToManager  => "badge bg-warning text-dark",
                                ApartmentTriage.Domain.Enums.RoutingAction.AssignTechnician   => "badge bg-primary",
                                ApartmentTriage.Domain.Enums.RoutingAction.NotifyResident     => "badge bg-info text-dark",
                                ApartmentTriage.Domain.Enums.RoutingAction.Defer              => "badge bg-secondary",
                                ApartmentTriage.Domain.Enums.RoutingAction.Archive            => "badge bg-dark",
                                _                                                              => "badge bg-secondary"
                            };
                            <span class="@routeClass">@t.RoutingAction.Value</span>
                        }
                        else
                        {
                            <span class="text-muted small">Henüz yönlendirilmedi</span>
                        }
                    </dd>

                    @if (Model.AmbiguityReasons.Any())
                    {
                        <dt class="col-sm-5">Belirsizlik</dt>
                        <dd class="col-sm-7">
                            @foreach (var r in Model.AmbiguityReasons)
                            {
                                <span class="badge bg-warning text-dark me-1">@r</span>
                            }
                        </dd>
                    }
                </dl>
            </div>
        </div>
    </div>

</div>
