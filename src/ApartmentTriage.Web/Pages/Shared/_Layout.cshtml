<!DOCTYPE html>
<html lang="tr" class="h-full">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Hanwas</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <style>
        [data-sidebar-active] { background-color: rgb(37 99 235); color: white; }
    </style>
</head>
<body class="bg-gray-50 h-full flex" id="app-body">

    @* Mobile sidebar overlay *@
    <div id="sidebar-overlay"
         class="fixed inset-0 bg-black/50 z-20 hidden md:hidden"
         onclick="closeSidebar()"></div>

    @* Sidebar *@
    <aside id="sidebar"
           class="fixed left-0 top-0 z-30 h-full w-56 bg-gray-900 text-white flex flex-col
                  -translate-x-full md:translate-x-0 transition-transform duration-200 ease-in-out">

        @* Logo *@
        <div class="flex items-center gap-3 px-4 py-4 border-b border-gray-700 shrink-0">
            <span class="text-xl">🏢</span>
            <div>
                <div class="font-semibold text-sm leading-tight">Hanwas</div>
                <div class="text-xs text-gray-400">AI Dashboard</div>
            </div>
        </div>

        @* Nav links *@
        <nav class="flex-1 px-2 py-4 space-y-0.5 overflow-y-auto">

            @{
                var path = Context.Request.Path;
                string NavClass(string route) => path == route || (route != "/" && path.StartsWithSegments(route))
                    ? "flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm bg-blue-600 text-white font-medium"
                    : "flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-gray-300 hover:bg-gray-800 hover:text-white transition-colors";
            }

            <a href="/overview" onclick="closeSidebar()" class="@NavClass("/overview")">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6" />
                </svg>
                <span class="lang-tr">Genel Bakış</span>
                <span class="lang-en">Overview</span>
            </a>

            <a href="/tickets" onclick="closeSidebar()" class="@NavClass("/tickets")">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
                </svg>
                <span class="lang-tr">Ticket'lar</span>
                <span class="lang-en">Tickets</span>
            </a>

            <a href="/inbox" onclick="closeSidebar()" class="@NavClass("/inbox")">
                <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                </svg>
                <span class="lang-tr">Mesajlar</span>
                <span class="lang-en">Messages</span>
            </a>

            <a href="/residents" onclick="closeSidebar()" class="@NavClass("/residents")">
                <i class="fa-solid fa-users shrink-0" style="width:16px;font-size:14px;text-align:center"></i>
                <span class="lang-tr">Sakinler</span>
                <span class="lang-en">Residents</span>
            </a>

            <div class="mt-4 border-t border-gray-700 pt-4">
                <a href="/hangfire" target="_blank"
                   class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-gray-800 hover:text-white transition-colors">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    Hangfire
                </a>
                <a href="/health" target="_blank"
                   class="flex items-center gap-2.5 px-3 py-2 rounded-lg text-sm text-gray-400 hover:bg-gray-800 hover:text-white transition-colors">
                    <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
                    </svg>
                    <span class="lang-tr">Sağlık</span>
                    <span class="lang-en">Health</span>
                </a>
            </div>
        </nav>
    </aside>

    @* Main content *@
    <div class="flex-1 md:ml-56 flex flex-col min-h-screen">

        @* Topbar *@
        <header class="sticky top-0 z-10 bg-white border-b border-gray-200 px-4 py-3 flex items-center justify-between shrink-0">
            <div class="flex items-center gap-3">
                @* Hamburger (mobile) *@
                <button onclick="toggleSidebar()"
                        class="md:hidden p-1.5 rounded-lg text-gray-500 hover:bg-gray-100">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
                    </svg>
                </button>

                @* Page title + live badge *@
                <div class="flex items-center gap-2">
                    <h1 class="font-semibold text-gray-900 text-base">
                        @if (ViewData["PageTitleTR"] != null) {
                            <span class="lang-tr">@ViewData["PageTitleTR"]</span>
                            <span class="lang-en">@ViewData["PageTitleEN"]</span>
                        } else {
                            @ViewData["Title"]
                        }
                    </h1>
                    <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full bg-green-50 text-green-700 text-xs font-medium border border-green-200">
                        <span class="w-1.5 h-1.5 bg-green-500 rounded-full animate-pulse"></span>
                        <span class="lang-tr">Canlı</span>
                        <span class="lang-en">Live</span>
                    </span>
                </div>
            </div>

            <div class="flex items-center gap-3">
                @* Istanbul clock *@
                <div class="hidden sm:flex items-center gap-1.5 text-sm text-gray-500">
                    <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                              d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span id="istanbul-clock" class="font-mono text-xs tabular-nums"></span>
                    <span class="text-xs text-gray-400">IST</span>
                </div>

                @* Language toggle *@
                <button onclick="toggleLang()" id="lang-btn"
                        class="px-2.5 py-1 rounded-md text-xs font-semibold bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors">
                    EN
                </button>

                @if (Context.User.Identity?.IsAuthenticated == true)
                {
                    <a href="/logout"
                       class="inline-flex items-center gap-1.5 rounded-md bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-600 transition-colors hover:bg-gray-200"
                       title="Logout">
                        <i class="fa-solid fa-arrow-right-from-bracket text-[11px]"></i>
                        <span class="hidden sm:inline">@(Context.User.FindFirst("displayName")?.Value ?? "Logout")</span>
                    </a>
                }
            </div>
        </header>

        @* Page body *@
        <main class="flex-1 p-4 md:p-6">
            @RenderBody()
        </main>

        <footer class="px-6 py-3 border-t border-gray-100 text-xs text-gray-400">
            Hanwas
        </footer>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/flowbite/2.3.0/flowbite.min.js"></script>

    <script>
    (function () {
        // ── Language ───────────────────────────────────────────────────────────
        // Toggles legacy .lang-tr/.lang-en spans AND data-attribute driven
        // text / placeholder / title. Use data-i18n-tr / data-i18n-en for
        // <option>, JS-built labels and fallbacks (where inline spans don't
        // render), data-i18n-{tr,en}-ph for placeholders, -title for tooltips.
        // Browser tab title can't host TR/EN spans → swap document.title per language.
        var PAGE_TITLE = {
            tr: @Html.Raw(Json.Serialize((ViewData["PageTitleTR"] ?? ViewData["Title"])?.ToString() ?? "")),
            en: @Html.Raw(Json.Serialize((ViewData["PageTitleEN"] ?? ViewData["Title"])?.ToString() ?? ""))
        };

        function applyLang(l) {
            var pt = PAGE_TITLE[l] || PAGE_TITLE.tr;
            if (pt) document.title = pt + ' — Hanwas';
            document.querySelectorAll('.lang-tr').forEach(function (e) {
                e.style.display = l === 'tr' ? '' : 'none';
            });
            document.querySelectorAll('.lang-en').forEach(function (e) {
                e.style.display = l === 'en' ? '' : 'none';
            });
            // Text content — selects/options, JS-generated labels, fallbacks
            document.querySelectorAll('[data-i18n-tr],[data-i18n-en]').forEach(function (e) {
                var v = e.getAttribute('data-i18n-' + l);
                if (v !== null) e.textContent = v;
            });
            // Input / textarea placeholders
            document.querySelectorAll('[data-i18n-tr-ph],[data-i18n-en-ph]').forEach(function (e) {
                var v = e.getAttribute('data-i18n-' + l + '-ph');
                if (v !== null) e.placeholder = v;
            });
            // Tooltips (title attribute)
            document.querySelectorAll('[data-i18n-tr-title],[data-i18n-en-title]').forEach(function (e) {
                var v = e.getAttribute('data-i18n-' + l + '-title');
                if (v !== null) e.title = v;
            });
            var btn = document.getElementById('lang-btn');
            if (btn) btn.textContent = l === 'tr' ? 'EN' : 'TR';
        }
        // Exposed so page scripts can re-apply after injecting dynamic DOM.
        window.applyLang = applyLang;
        window.atriageLang = function () { return localStorage.getItem('atriage_lang') || 'tr'; };

        window.toggleLang = function () {
            var current = localStorage.getItem('atriage_lang') || 'tr';
            var next = current === 'tr' ? 'en' : 'tr';
            localStorage.setItem('atriage_lang', next);
            applyLang(next);
        };

        var initialLang = localStorage.getItem('atriage_lang') || 'tr';
        applyLang(initialLang);

        // ── Istanbul clock ─────────────────────────────────────────────────────
        function updateClock() {
            var el = document.getElementById('istanbul-clock');
            if (!el) return;
            var now = new Date();
            try {
                var formatted = now.toLocaleString('tr-TR', {
                    timeZone: 'Europe/Istanbul',
                    day: '2-digit',
                    month: 'short',
                    hour: '2-digit',
                    minute: '2-digit'
                });
                el.textContent = formatted;
            } catch (e) {
                var utc3 = new Date(now.getTime() + 3 * 3600000);
                el.textContent = utc3.toISOString().slice(0, 16).replace('T', ' ');
            }
        }
        updateClock();
        setInterval(updateClock, 10000);

        // ── Sidebar (mobile) ───────────────────────────────────────────────────
        window.toggleSidebar = function () {
            var s = document.getElementById('sidebar');
            var o = document.getElementById('sidebar-overlay');
            s.classList.toggle('-translate-x-full');
            o.classList.toggle('hidden');
        };
        window.closeSidebar = function () {
            document.getElementById('sidebar').classList.add('-translate-x-full');
            document.getElementById('sidebar-overlay').classList.add('hidden');
        };
    })();
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
