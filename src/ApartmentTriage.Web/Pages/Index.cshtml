@page "/overview"
@model ApartmentTriage.Web.Pages.IndexModel
@using ApartmentTriage.Domain.Enums
@using ApartmentTriage.Web.Helpers
@{
    ViewData["Title"]       = "Genel Bakış";
    ViewData["PageTitleTR"] = "Genel Bakış";
    ViewData["PageTitleEN"] = "Overview";

    string Pct(double? v) => v.HasValue ? $"%{(v.Value * 100).ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)}" : "—";
}

@* ── Tab navigation ──────────────────────────────────────────────────────────── *@
<div class="border-b border-slate-200 mb-6">
    <nav class="flex gap-6 -mb-px text-sm" id="ov-tab-nav">
        <button type="button" data-tab="ops" class="ov-tab py-2.5 border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition-colors">
            <span class="lang-tr">Operasyon</span><span class="lang-en">Operations</span>
        </button>
        <button type="button" data-tab="perf" class="ov-tab py-2.5 border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition-colors">
            <span class="lang-tr">Performans</span><span class="lang-en">Performance</span>
        </button>
        <button type="button" data-tab="finops" class="ov-tab py-2.5 border-b-2 border-transparent text-slate-500 hover:text-slate-700 transition-colors">
            FinOps
        </button>
    </nav>
</div>

@* ═══════════════ TAB 1 — PERFORMANS ═══════════════ *@
<div data-panel="perf">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">

        @* Category accuracy *@
        <div class="bg-white rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">Kategori Doğruluğu</span>
                <span class="lang-en">Category Accuracy</span>
            </p>
            <p class="text-2xl font-bold text-emerald-600">@Pct(Model.CategoryAccuracy)</p>
            <p class="text-xs text-slate-400 mt-0.5">@Model.EvalTotalCases
                <span class="lang-tr">vaka</span><span class="lang-en">cases</span>
                @if (Model.EvalRunDate is not null) { <text>· @Model.EvalRunDate</text> }
            </p>
        </div>

        @* Emergency recall *@
        <div class="bg-white rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">Acil Recall</span>
                <span class="lang-en">Emergency Recall</span>
            </p>
            <p class="text-2xl font-bold text-emerald-600">@Pct(Model.EmergencyRecall)</p>
            <p class="text-xs text-slate-400 mt-0.5">
                <span class="lang-tr">hiçbir acil kaçmıyor</span>
                <span class="lang-en">no emergency missed</span>
            </p>
        </div>

        @* Emergency precision — the honest trade-off *@
        <div class="bg-white rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">Acil Precision</span>
                <span class="lang-en">Emergency Precision</span>
            </p>
            <p class="text-2xl font-bold text-amber-600">@Pct(Model.EmergencyPrecision)</p>
            <p class="text-xs text-slate-400 mt-0.5">
                <span class="lang-tr">bilinçli temkinli</span>
                <span class="lang-en">deliberately cautious</span>
            </p>
        </div>

        @* AI confidence distribution (replaces the old fake average) *@
        <div class="bg-white rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1.5">
                <span class="lang-tr">AI Güven Dağılımı</span>
                <span class="lang-en">AI Confidence</span>
            </p>
            @if (Model.ConfTotal > 0)
            {
                <div class="flex h-2.5 rounded-full overflow-hidden bg-slate-100">
                    <div class="bg-emerald-500" style="width:@(Model.ConfPct(Model.ConfHigh))%"   title="High @Model.ConfHigh"></div>
                    <div class="bg-amber-400"   style="width:@(Model.ConfPct(Model.ConfMedium))%" title="Medium @Model.ConfMedium"></div>
                    <div class="bg-rose-400"    style="width:@(Model.ConfPct(Model.ConfLow))%"    title="Low @Model.ConfLow"></div>
                </div>
                <div class="flex justify-between text-xs text-slate-500 mt-2">
                    <span><span class="lang-tr">Yüksek</span><span class="lang-en">High</span> @Model.ConfHigh</span>
                    <span><span class="lang-tr">Orta</span><span class="lang-en">Med</span> @Model.ConfMedium</span>
                    <span><span class="lang-tr">Düşük</span><span class="lang-en">Low</span> @Model.ConfLow</span>
                </div>
            }
            else
            {
                <p class="text-2xl font-bold text-slate-300">—</p>
            }
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4">
        <div class="bg-white rounded-xl border border-slate-200">
            <div class="px-5 py-3.5 border-b border-slate-100">
                <h2 class="font-semibold text-slate-900 text-sm">
                    <span class="lang-tr">Kategori Dağılımı</span>
                    <span class="lang-en">Category Distribution</span>
                </h2>
            </div>
            <div class="p-4"><canvas id="categoryChart" height="260"></canvas></div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200">
            <div class="px-5 py-3.5 border-b border-slate-100">
                <h2 class="font-semibold text-slate-900 text-sm">
                    <span class="lang-tr">Şiddet Dağılımı</span>
                    <span class="lang-en">Severity Distribution</span>
                </h2>
            </div>
            <div class="p-4 flex items-center justify-center"><canvas id="severityChart" height="240"></canvas></div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200">
            <div class="px-5 py-3.5 border-b border-slate-100">
                <h2 class="font-semibold text-slate-900 text-sm">
                    <span class="lang-tr">Yönlendirme Dağılımı</span>
                    <span class="lang-en">Routing Distribution</span>
                </h2>
            </div>
            <div class="p-4"><canvas id="routingChart" height="240"></canvas></div>
        </div>
    </div>
</div>

@* ═══════════════ TAB 2 — FINOPS ═══════════════ *@
<div data-panel="finops" class="hidden">
    <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
        <div class="bg-white rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">Ölçülen API Maliyeti</span>
                <span class="lang-en">Measured API Cost</span>
            </p>
            <p id="fin-total-cost" class="text-2xl font-bold text-slate-900">—</p>
            <p id="fin-since" class="text-xs text-slate-400 mt-0.5">&nbsp;</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">API Çağrısı</span>
                <span class="lang-en">API Calls</span>
            </p>
            <p id="fin-total-calls" class="text-2xl font-bold text-slate-900">—</p>
            <p class="text-xs text-slate-400 mt-0.5">
                <span class="lang-tr">canlı kullanımdan</span>
                <span class="lang-en">from live usage</span>
            </p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">Haiku / Sonnet Oranı</span>
                <span class="lang-en">Haiku / Sonnet Ratio</span>
            </p>
            @{
                var modelTotal = Model.HaikuCount + Model.SonnetCount;
                var haikuPct = modelTotal > 0 ? (int)Math.Round((double)Model.HaikuCount / modelTotal * 100) : 0;
            }
            <p class="text-2xl font-bold text-slate-900">@haikuPct% / @(100 - haikuPct)%</p>
            <p class="text-xs text-slate-400 mt-0.5">@Model.HaikuCount Haiku · @Model.SonnetCount Sonnet</p>
        </div>
        <div class="bg-white rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">Barındırma</span>
                <span class="lang-en">Hosting</span>
            </p>
            <p class="text-2xl font-bold text-slate-900">Fly.io + Neon</p>
            <p class="text-xs text-slate-400 mt-0.5">
                <span class="lang-tr">Free tier (her ikisi)</span>
                <span class="lang-en">Free tier (both)</span>
            </p>
        </div>
    </div>

    <div id="fin-empty" class="hidden bg-white rounded-xl border border-dashed border-slate-300 p-8 text-center mb-4">
        <i class="fa-solid fa-chart-line text-slate-300 text-2xl mb-2"></i>
        <p class="text-sm font-medium text-slate-600">
            <span class="lang-tr">Henüz maliyet verisi yok</span>
            <span class="lang-en">No cost data yet</span>
        </p>
        <p class="text-xs text-slate-400 mt-1 max-w-md mx-auto">
            <span class="lang-tr">Maliyet, yalnızca yayına alındıktan sonra triage edilen mesajlardan ölçülür (geçmişe dönük değil). Bota bir bakım mesajı işlendiğinde grafikler dolar.</span>
            <span class="lang-en">Cost is measured only from messages triaged after deployment (not retroactive). The charts populate once a maintenance message is processed.</span>
        </p>
    </div>

    <div id="fin-charts">
    @* 1/2 (trend + note) + 1/2 (model + agent stacked) *@
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4 items-start">

        @* Sol: Daily Cost Trend + Cost Note *@
        <div class="flex flex-col gap-4">
            <div class="bg-white rounded-xl border border-slate-200">
                <div class="px-5 py-3.5 border-b border-slate-100">
                    <h2 class="font-semibold text-slate-900 text-sm">
                        <span class="lang-tr">Günlük Maliyet Trendi</span>
                        <span class="lang-en">Daily Cost Trend</span>
                    </h2>
                </div>
                <div class="p-4"><canvas id="costTrendChart" height="190"></canvas></div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200 p-5">
                <h2 class="font-semibold text-slate-900 text-sm mb-2">
                    <span class="lang-tr">Maliyet Notu</span>
                    <span class="lang-en">Cost Note</span>
                </h2>
                <p class="text-xs text-slate-500 leading-relaxed">
                    <span class="lang-tr">Maliyet, her API çağrısının gerçek token kullanımından (self-instrumented) türetilir; oranlar yapılandırılabilir. Haiku 4.5 varsayılan; yalnız düşük güvenli sınıflandırmalar Sonnet 4.6'ya yükseltilir, böylece harcamanın büyük kısmı Haiku tarafında kalır.</span>
                    <span class="lang-en">Cost is derived from each call's real token usage (self-instrumented); rates are configurable. Haiku 4.5 is the default; only low-confidence classifications escalate to Sonnet 4.6, keeping the bulk of spend on the Haiku side.</span>
                </p>
            </div>
        </div>

        @* Sağ: Cost by Model + Cost by Agent stacked *@
        <div class="flex flex-col gap-4">
            <div class="bg-white rounded-xl border border-slate-200">
                <div class="px-5 py-3.5 border-b border-slate-100">
                    <h2 class="font-semibold text-slate-900 text-sm">
                        <span class="lang-tr">Modele Göre Maliyet</span>
                        <span class="lang-en">Cost by Model</span>
                    </h2>
                </div>
                <div class="p-3 flex items-center justify-center"><canvas id="modelChart" height="170"></canvas></div>
            </div>
            <div class="bg-white rounded-xl border border-slate-200">
                <div class="px-5 py-3.5 border-b border-slate-100">
                    <h2 class="font-semibold text-slate-900 text-sm">
                        <span class="lang-tr">Agent'a Göre Maliyet</span>
                        <span class="lang-en">Cost by Agent</span>
                    </h2>
                </div>
                <div class="p-3"><canvas id="agentCostChart" height="170"></canvas></div>
            </div>
        </div>

    </div>
    </div>@* /#fin-charts *@
</div>

@* ═══════════════ TAB 3 — OPERASYON ═══════════════ *@
<div data-panel="ops" class="hidden">
    <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-6">

        @* Total tickets — cross-link *@
        <a href="/tickets" class="bg-white rounded-xl border border-slate-200 p-4 hover:border-amber-600 hover:shadow-sm transition-all">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">Toplam Ticket</span>
                <span class="lang-en">Total Tickets</span>
            </p>
            <p class="text-2xl font-bold text-slate-900">@Model.TotalTickets</p>
        </a>

        @* Emergency — cross-link *@
        <a href="/tickets?emergency=true" class="bg-white rounded-xl border border-rose-200 p-4 hover:border-rose-400 hover:shadow-sm transition-all">
            <p class="text-xs font-medium text-rose-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">Acil Durum</span>
                <span class="lang-en">Emergency</span>
            </p>
            <p class="text-2xl font-bold text-rose-600">@Model.EmergencyCount</p>
        </a>

        @* Active residents *@
        <div class="bg-white rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">Aktif Sakin</span>
                <span class="lang-en">Active Residents</span>
            </p>
            <p class="text-2xl font-bold text-slate-900">@Model.ActiveResidents</p>
            <p class="text-xs text-slate-400 mt-0.5">/ @Model.TotalResidents
                <span class="lang-tr">toplam</span><span class="lang-en">total</span>
            </p>
        </div>

        @* Total messages *@
        <div class="bg-white rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">Toplam Mesaj</span>
                <span class="lang-en">Total Messages</span>
            </p>
            <p class="text-2xl font-bold text-slate-900">@Model.TotalMessages</p>
        </div>

        @* Daily average *@
        <div class="bg-white rounded-xl border border-slate-200 p-4">
            <p class="text-xs font-medium text-slate-500 uppercase tracking-wide mb-1">
                <span class="lang-tr">Günlük Ort.</span>
                <span class="lang-en">Daily Avg.</span>
            </p>
            <p class="text-2xl font-bold text-slate-900">@Model.DailyAvgTickets.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture)</p>
            <p class="text-xs text-slate-400 mt-0.5">
                <span class="lang-tr">ticket / aktif gün</span>
                <span class="lang-en">tickets / active day</span>
            </p>
        </div>
    </div>

    @* Row: live feed (2/3) | Ticket Status + Channel Distribution stacked (1/3) *@
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-4">
        @* Live triage feed — 2/3 *@
        <div class="lg:col-span-2 bg-white rounded-xl border border-slate-200">
            <div class="px-5 py-3.5 border-b border-slate-100 flex items-center justify-between">
                <h2 class="font-semibold text-slate-900 text-sm flex items-center gap-2">
                    <span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>
                    <span class="lang-tr">Canlı Triage Akışı</span>
                    <span class="lang-en">Live Triage Feed</span>
                </h2>
                <a href="/tickets" class="text-xs text-amber-600 hover:underline">
                    <span class="lang-tr">Tümünü gör →</span>
                    <span class="lang-en">View all →</span>
                </a>
            </div>
            @if (!Model.RecentTickets.Any())
            {
                <div class="px-5 py-8 text-center text-slate-400 text-sm">
                    <span class="lang-tr">Henüz ticket yok.</span>
                    <span class="lang-en">No tickets yet.</span>
                </div>
            }
            else
            {
                <ul class="divide-y divide-slate-50">
                    @foreach (var item in Model.RecentTickets)
                    {
                        var sevColor = item.Severity switch
                        {
                            TicketSeverity.Urgent => "bg-rose-100 text-rose-700",
                            TicketSeverity.High   => "bg-orange-100 text-orange-700",
                            TicketSeverity.Medium => "bg-blue-100 text-blue-700",
                            _                     => "bg-slate-100 text-slate-600"
                        };
                        var catLbl = EnumLabels.For(item.Category);
                        var svLbl  = EnumLabels.For(item.Severity);
                        <li class="hover:bg-slate-50 transition-colors">
                            <a href="/tickets/@item.Id" class="block px-5 py-3">
                                <div class="flex items-start justify-between gap-3">
                                    <div class="flex items-start gap-2 min-w-0">
                                        <span class="mt-0.5 shrink-0 w-4 text-center">
                                            @if (item.Channel == ChannelType.WhatsApp)
                                            {
                                                <i class="fa-brands fa-whatsapp" style="color:#25D366;font-size:13px"></i>
                                            }
                                            else if (item.Channel == ChannelType.Telegram)
                                            {
                                                <i class="fa-brands fa-telegram" style="color:#229ED9;font-size:13px"></i>
                                            }
                                            else
                                            {
                                                <span class="inline-block w-2 h-2 rounded-full bg-slate-400 mt-1"></span>
                                            }
                                        </span>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <span class="text-xs font-medium text-slate-700" data-i18n-tr="@catLbl.Tr" data-i18n-en="@catLbl.En">@catLbl.Tr</span>
                                                @if (item.IsEmergency)
                                                {
                                                    <span class="px-1.5 py-0.5 rounded text-xs font-bold bg-rose-600 text-white">
                                                        <span class="lang-tr">ACİL</span><span class="lang-en">EMRG</span>
                                                    </span>
                                                }
                                            </div>
                                            <p class="text-xs text-slate-400 mt-0.5 truncate">@item.Preview</p>
                                            <p class="text-xs text-slate-400 mt-0.5">@if (string.IsNullOrEmpty(item.Resident)) { <span data-i18n-tr="Sakin" data-i18n-en="Resident">Sakin</span> } else { @item.Resident }</p>
                                        </div>
                                    </div>
                                    <div class="shrink-0 flex flex-col items-end gap-1">
                                        <span class="px-2 py-0.5 rounded-full text-xs font-medium @sevColor" data-i18n-tr="@svLbl.Tr" data-i18n-en="@svLbl.En">@svLbl.Tr</span>
                                        <span class="text-xs text-slate-400">@item.TimeIst</span>
                                    </div>
                                </div>
                            </a>
                        </li>
                    }
                </ul>
            }
        </div>

        @* Right column: Ticket Status (top) + Channel Distribution (bottom) — 1/3 *@
        <div class="flex flex-col gap-4">
            @* Ticket status distribution (cards + donut) *@
            <div class="bg-white rounded-xl border border-slate-200 flex-1">
                <div class="px-5 py-3.5 border-b border-slate-100">
                    <h2 class="font-semibold text-slate-900 text-sm">
                        <span class="lang-tr">Ticket Durumu</span>
                        <span class="lang-en">Ticket Status</span>
                    </h2>
                </div>
                <div class="p-4">
                    <div id="ov-status-cards" class="flex flex-wrap gap-2 mb-3"></div>
                    <div class="flex items-center justify-center"><canvas id="statusChart" height="150"></canvas></div>
                </div>
            </div>

            @* Channel distribution — 1/3 bottom *@
            <div class="bg-white rounded-xl border border-slate-200">
                <div class="px-5 py-3.5 border-b border-slate-100">
                    <h2 class="font-semibold text-slate-900 text-sm">
                        <span class="lang-tr">Kanal Dağılımı</span>
                        <span class="lang-en">Channel Distribution</span>
                    </h2>
                </div>
                <div class="p-4 flex items-center justify-center"><canvas id="channelChart" height="150"></canvas></div>
            </div>
        </div>
    </div>

    @* Row: Daily Trend (1/2) + Hourly Intensity (1/2) — equal width *@
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-4 mb-4">
        <div class="bg-white rounded-xl border border-slate-200">
            <div class="px-5 py-3.5 border-b border-slate-100">
                <h2 class="font-semibold text-slate-900 text-sm">
                    <span class="lang-tr">Günlük Ticket Trendi</span>
                    <span class="lang-en">Daily Ticket Trend</span>
                </h2>
            </div>
            <div class="p-4"><canvas id="trendChart" height="200"></canvas></div>
        </div>
        <div class="bg-white rounded-xl border border-slate-200">
            <div class="px-5 py-3.5 border-b border-slate-100">
                <h2 class="font-semibold text-slate-900 text-sm">
                    <span class="lang-tr">Saat Bazlı Yoğunluk</span>
                    <span class="lang-en">Hourly Intensity</span>
                </h2>
            </div>
            <div class="p-4"><canvas id="hourlyChart" height="200"></canvas></div>
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    var ACCENT = '#d97706', SLATE = '#64748b';

    function lang() { return window.atriageLang ? window.atriageLang() : 'tr'; }
    function pick(pair) { return lang() === 'en' ? pair[1] : pair[0]; }

    // Label maps mirror Web/Helpers/EnumLabels.cs (server side).
    var CAT = {
        Plumbing:['Tesisat','Plumbing'], Electrical:['Elektrik','Electrical'], Gas:['Doğalgaz','Gas'],
        HeatingCooling:['Isıtma/Soğutma','Heating/Cooling'], Elevator:['Asansör','Elevator'],
        Structural:['Yapısal','Structural'], CommonArea:['Ortak Alan','Common Area'], Pest:['Haşere','Pest'],
        Noise:['Gürültü','Noise'], NeighborDispute:['Komşu Anlaş.','Neighbor Disp.'], Billing:['Aidat/Fatura','Billing'],
        Security:['Güvenlik','Security'], Announcement:['Duyuru','Announcement'], Other:['Diğer','Other']
    };
    var SEV = { Low:['Düşük','Low'], Medium:['Orta','Medium'], High:['Yüksek','High'], Urgent:['Acil','Urgent'] };
    var ROUTE = {
        NotifyResident:['Sakine Bildir','Notify Resident'], AssignTechnician:['Teknisyen Ata','Assign Technician'],
        EscalateToManager:['Yön. Yükselt','Escalate'], TriggerEmergency:['Acil Müdahale','Emergency'],
        Defer:['Ertele','Defer'], Archive:['Arşivle','Archive']
    };
    var STATUS = {
        Open:       { l:['Açık','Open'],            cls:'border-blue-200 bg-blue-50 text-blue-700',    dot:'#3B82F6' },
        InProgress: { l:['İşlemde','In Progress'],  cls:'border-amber-200 bg-amber-50 text-amber-700', dot:'#F59E0B' },
        Resolved:   { l:['Çözüldü','Resolved'],     cls:'border-green-200 bg-green-50 text-green-700', dot:'#22C55E' },
        Closed:     { l:['Kapalı','Closed'],        cls:'border-slate-200 bg-slate-50 text-slate-600', dot:'#6B7280' }
    };
    var SEV_COLOR = { Low:'#9CA3AF', Medium:'#60A5FA', High:'#FB923C', Urgent:'#EF4444' };
    var ROUTE_COLOR = { TriggerEmergency:'#EF4444', EscalateToManager:'#F97316', AssignTechnician:'#3B82F6', NotifyResident:'#8B5CF6', Defer:'#6B7280', Archive:'#374151' };

    function getJSON(url) { return fetch(url).then(function (r) { return r.json(); }).catch(function (e) { console.warn('fetch failed', url, e); return null; }); }

    var charts = {};
    function set(id, cfg) {
        var el = document.getElementById(id);
        if (!el) return;
        if (charts[id]) charts[id].destroy();
        charts[id] = new Chart(el, cfg);
    }

    // ── Tab 1: Performans ───────────────────────────────────────────────────
    function buildPerf() {
        getJSON('/api/stats/categories').then(function (d) {
            if (!d) return;
            set('categoryChart', {
                type: 'bar',
                data: { labels: d.map(function (x) { return pick(CAT[x.category] || [x.category, x.category]); }),
                        datasets: [{ data: d.map(function (x) { return x.count; }), backgroundColor: ACCENT, borderRadius: 4 }] },
                options: { indexAxis: 'y', plugins: { legend: { display: false } },
                           scales: { x: { grid: { display: false }, ticks: { font: { size: 11 }, precision: 0 } },
                                     y: { grid: { display: false }, ticks: { font: { size: 10 } } } } }
            });
        });
        getJSON('/api/stats/severity').then(function (d) {
            if (!d) return;
            set('severityChart', {
                type: 'doughnut',
                data: { labels: d.map(function (x) { return pick(SEV[x.severity] || [x.severity, x.severity]); }),
                        datasets: [{ data: d.map(function (x) { return x.count; }), backgroundColor: d.map(function (x) { return SEV_COLOR[x.severity] || SLATE; }), borderWidth: 0 }] },
                options: { cutout: '58%', plugins: { legend: { position: 'bottom', labels: { font: { size: 10 }, boxWidth: 10, padding: 8 } } } }
            });
        });
        getJSON('/api/stats/routing').then(function (d) {
            if (!d) return;
            set('routingChart', {
                type: 'bar',
                data: { labels: d.map(function (x) { return pick(ROUTE[x.action] || [x.action, x.action]); }),
                        datasets: [{ data: d.map(function (x) { return x.count; }), backgroundColor: d.map(function (x) { return ROUTE_COLOR[x.action] || SLATE; }), borderRadius: 4 }] },
                options: { indexAxis: 'y', plugins: { legend: { display: false } },
                           scales: { x: { grid: { display: false }, ticks: { font: { size: 10 }, precision: 0 } },
                                     y: { grid: { display: false }, ticks: { font: { size: 10 } } } } }
            });
        });
    }

    // ── Tab 2: FinOps (self-instrumented cost) ──────────────────────────────
    function usdTip(suffix) {
        return { callbacks: { label: function (ctx) {
            var v = ctx.parsed && ctx.parsed.y != null ? ctx.parsed.y
                  : (ctx.parsed && ctx.parsed.x != null ? ctx.parsed.x : ctx.parsed);
            return '$' + Number(v).toFixed(4) + (suffix || '');
        } } };
    }
    function agentLabel(a) {
        var m = { classifier: 'Classifier', enricher: 'Enricher', router: 'Router', system: 'System' };
        return m[a] || (a ? a.charAt(0).toUpperCase() + a.slice(1) : a);
    }

    function buildFinops() {
        getJSON('/api/stats/cost-summary').then(function (d) {
            if (!d) return;
            var t = document.getElementById('fin-total-cost');
            if (t) t.textContent = '$' + Number(d.totalUsd || 0).toFixed(4);
            var c = document.getElementById('fin-total-calls');
            if (c) c.textContent = (d.totalCalls || 0).toLocaleString();
            var s = document.getElementById('fin-since');
            if (s) s.textContent = d.sinceIst ? pick(['ölçüm: ', 'since ']) + d.sinceIst : pick(['henüz veri yok', 'no data yet']);

            // No usage recorded yet → show the explanatory empty state instead of blank charts.
            var hasData = (d.totalCalls || 0) > 0;
            var empty = document.getElementById('fin-empty');
            var charts = document.getElementById('fin-charts');
            if (empty) empty.classList.toggle('hidden', hasData);
            if (charts) charts.classList.toggle('hidden', !hasData);
            if (!hasData) return;

            if (d.byModel && d.byModel.length) {
                set('modelChart', {
                    type: 'doughnut',
                    data: { labels: d.byModel.map(function (x) { return x.model; }),
                            datasets: [{ data: d.byModel.map(function (x) { return x.usd; }), backgroundColor: ['#d97706', '#818CF8', '#10b981'], borderWidth: 0 }] },
                    options: { cutout: '58%', plugins: { legend: { position: 'bottom', labels: { font: { size: 11 }, boxWidth: 10, padding: 10 } }, tooltip: usdTip() } }
                });
            }
            if (d.byAgent && d.byAgent.length) {
                set('agentCostChart', {
                    type: 'bar',
                    data: { labels: d.byAgent.map(function (x) { return agentLabel(x.agent); }),
                            datasets: [{ data: d.byAgent.map(function (x) { return x.usd; }), backgroundColor: '#0ea5e9', borderRadius: 4 }] },
                    options: { indexAxis: 'y', plugins: { legend: { display: false }, tooltip: usdTip() },
                               scales: { x: { grid: { display: false }, ticks: { font: { size: 10 }, callback: function (v) { return '$' + v; } } },
                                         y: { grid: { display: false }, ticks: { font: { size: 11 } } } } }
                });
            }
        });
        getJSON('/api/stats/cost-trend').then(function (d) {
            if (!d || !d.length) return;
            set('costTrendChart', {
                type: 'line',
                data: { labels: d.map(function (x) { return x.date; }),
                        datasets: [{ data: d.map(function (x) { return x.usd; }), borderColor: '#d97706', backgroundColor: 'rgba(217,119,6,0.1)', fill: true, tension: 0.3, pointRadius: 2 }] },
                options: { plugins: { legend: { display: false }, tooltip: usdTip() },
                           scales: { x: { grid: { display: false }, ticks: { font: { size: 9 }, maxRotation: 0, autoSkip: true } },
                                     y: { grid: { color: '#f1f5f9' }, ticks: { font: { size: 10 }, callback: function (v) { return '$' + v; } }, beginAtZero: true } } }
            });
        });
    }

    // ── Tab 3: Operasyon ────────────────────────────────────────────────────
    function buildOps() {
        // Status cards + donut
        getJSON('/api/stats/ticket-status').then(function (d) {
            var el = document.getElementById('ov-status-cards');
            if (el && d && d.length) {
                el.innerHTML = d.map(function (x) {
                    var s = STATUS[x.status] || { l: [x.status, x.status], cls: 'border-slate-200 bg-slate-50 text-slate-600', dot: SLATE };
                    return '<a href="/tickets?FilterStatus=' + encodeURIComponent(x.status) + '" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg border ' + s.cls + ' hover:shadow-sm transition-all">' +
                           '<span class="w-2 h-2 rounded-full" style="background:' + s.dot + '"></span>' +
                           '<span class="text-xs font-medium" data-i18n-tr="' + s.l[0] + '" data-i18n-en="' + s.l[1] + '">' + pick(s.l) + '</span>' +
                           '<span class="text-sm font-bold">' + x.count + '</span></a>';
                }).join('');
                if (window.applyLang) window.applyLang(lang());
            }
            if (d && d.length) {
                set('statusChart', {
                    type: 'doughnut',
                    data: { labels: d.map(function (x) { return pick((STATUS[x.status] || { l: [x.status, x.status] }).l); }),
                            datasets: [{ data: d.map(function (x) { return x.count; }), backgroundColor: d.map(function (x) { return (STATUS[x.status] || { dot: SLATE }).dot; }), borderWidth: 0 }] },
                    options: { cutout: '58%', plugins: { legend: { position: 'bottom', labels: { font: { size: 10 }, boxWidth: 10, padding: 8 } } } }
                });
            }
        });
        // Daily trend (line)
        getJSON('/api/stats/trends').then(function (d) {
            if (!d) return;
            set('trendChart', {
                type: 'line',
                data: { labels: d.map(function (x) { return x.date; }),
                        datasets: [{ data: d.map(function (x) { return x.count; }), borderColor: ACCENT, backgroundColor: 'rgba(217,119,6,0.1)', fill: true, tension: 0.3, pointRadius: 2 }] },
                options: { plugins: { legend: { display: false } },
                           scales: { x: { grid: { display: false }, ticks: { font: { size: 9 }, maxRotation: 0, autoSkip: true } },
                                     y: { grid: { color: '#f1f5f9' }, ticks: { precision: 0, font: { size: 10 } }, beginAtZero: true } } }
            });
        });
        // Hourly intensity (bar)
        getJSON('/api/stats/hourly').then(function (d) {
            if (!d) return;
            set('hourlyChart', {
                type: 'bar',
                data: { labels: d.map(function (x) { return x.label; }),
                        datasets: [{ data: d.map(function (x) { return x.count; }), backgroundColor: '#94a3b8', borderRadius: 3 }] },
                options: { plugins: { legend: { display: false } },
                           scales: { x: { grid: { display: false }, ticks: { font: { size: 9 }, autoSkip: true, maxRotation: 0 } },
                                     y: { grid: { color: '#f1f5f9' }, ticks: { precision: 0, font: { size: 10 } }, beginAtZero: true } } }
            });
        });
        // Channel donut (server counts)
        var wa = @Model.WaCount, tg = @Model.TgCount;
        if (wa + tg > 0) {
            set('channelChart', {
                type: 'doughnut',
                data: { labels: ['WhatsApp', 'Telegram'], datasets: [{ data: [wa, tg], backgroundColor: ['#25D366', '#229ED9'], borderWidth: 0 }] },
                options: { cutout: '58%', plugins: { legend: { position: 'bottom', labels: { font: { size: 10 }, boxWidth: 10, padding: 8 } } } }
            });
        }
    }

    // ── Tab machinery (lazy build per tab) ──────────────────────────────────
    var built = { perf: false, finops: false, ops: false };
    var builders = { perf: buildPerf, finops: buildFinops, ops: buildOps };

    function activate(name) {
        document.querySelectorAll('[data-panel]').forEach(function (p) {
            p.classList.toggle('hidden', p.getAttribute('data-panel') !== name);
        });
        document.querySelectorAll('.ov-tab').forEach(function (b) {
            var on = b.getAttribute('data-tab') === name;
            b.classList.toggle('border-amber-600', on);
            b.classList.toggle('text-amber-600', on);
            b.classList.toggle('font-semibold', on);
            b.classList.toggle('border-transparent', !on);
            b.classList.toggle('text-slate-500', !on);
        });
        if (!built[name]) { built[name] = true; builders[name](); }
    }

    document.querySelectorAll('.ov-tab').forEach(function (b) {
        b.addEventListener('click', function () { activate(b.getAttribute('data-tab')); });
    });

    activate('ops');

    // Re-render charts (labels) when language toggles.
    var origToggle = window.toggleLang;
    window.toggleLang = function () {
        if (origToggle) origToggle();
        Object.keys(built).forEach(function (k) { if (built[k]) builders[k](); });
    };
})();
</script>
}
