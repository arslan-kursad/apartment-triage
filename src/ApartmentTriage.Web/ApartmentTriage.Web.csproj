<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <RootNamespace>ApartmentTriage.Web</RootNamespace>
    <UserSecretsId>apartment-triage-web</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ApartmentTriage.Application\ApartmentTriage.Application.csproj" />
    <ProjectReference Include="..\ApartmentTriage.Infrastructure\ApartmentTriage.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- EF Core design-time (migrations startup project requirement) -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>

    <!-- Hangfire dashboard -->
    <PackageReference Include="Hangfire.AspNetCore" Version="1.8.14" />

    <!-- Logging -->
    <PackageReference Include="Serilog.AspNetCore" Version="8.0.2" />
    <PackageReference Include="Serilog.Sinks.Console" Version="6.0.0" />
    <PackageReference Include="Serilog.Formatting.Compact" Version="3.0.0" />
  </ItemGroup>

</Project>
